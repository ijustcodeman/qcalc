<?xml version="1.0" encoding="utf-8"?>
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rowCount="8"
    android:columnCount="4"
    android:padding="12dp">

    <TextView
        android:id="@+id/display"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_columnSpan="4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1.8"
        android:layout_columnWeight="1"
        android:text="0"
        android:textSize="64sp"
        android:singleLine="true"
        android:ellipsize="start"
        android:gravity="end|center_vertical"
        android:padding="24dp" />

    <Button
        android:id="@+id/mr"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="MR"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark" />

    <Button
        android:id="@+id/ms"
        android:layout_row="1"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="MS"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark" />

    <Button
        android:id="@+id/leftBracket"
        android:layout_row="1"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="("
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/rightBracket"
        android:layout_row="1"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text=")"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/c"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="C"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark" />

    <Button
        android:id="@+id/ce"
        android:layout_row="2"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="CE"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark" />

    <Button
        android:id="@+id/pm"
        android:layout_row="2"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="+/-"
        android:textStyle="bold"
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/division"
        android:layout_row="2"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="/"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/sin"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="sin"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/cos"
        android:layout_row="3"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="cos"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/tan"
        android:layout_row="3"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="tan"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/sqrt"
        android:layout_row="3"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="√"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/seven"
        android:layout_row="4"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="7"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/eight"
        android:layout_row="4"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/nine"
        android:layout_row="4"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="9"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/multiply"
        android:layout_row="4"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="*"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/four"
        android:layout_row="5"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="4"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/five"
        android:layout_row="5"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="5"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/six"
        android:layout_row="5"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="6"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/minus"
        android:layout_row="5"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="-"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/one"
        android:layout_row="6"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="1"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/two"
        android:layout_row="6"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="2"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/three"
        android:layout_row="6"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="3"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/plus"
        android:layout_row="6"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="+"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light" />

    <Button
        android:id="@+id/zero"
        android:layout_row="7"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="0"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers" />

    <Button
        android:id="@+id/equal"
        android:layout_row="7"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:text="="
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/equals" />

</GridLayout>