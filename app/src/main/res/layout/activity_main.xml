<?xml version="1.0" encoding="utf-8"?>
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rowCount="8"
    android:columnCount="4"
    android:padding="8dp">

    <!-- DISPLAY -->
    <TextView
        android:id="@+id/display"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_columnSpan="4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1.5"
        android:layout_columnWeight="1"
        android:text="0"
        android:textSize="50sp"
        android:singleLine="true"
        android:ellipsize="start"
        android:gravity="end|center_vertical"
        android:padding="16dp" />

    <!-- ROW 1 -->
    <Button
        android:id="@+id/advanced"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_columnSpan="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark"
        android:text="ADVANCED" />

    <Button
        android:id="@+id/leftBracket"
        android:layout_row="1"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light"
        android:text="(" />

    <Button
        android:id="@+id/rightBracket"
        android:layout_row="1"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light"
        android:text=")" />

    <!-- ROW 2 -->
    <Button
        android:id="@+id/mr"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark"
        android:text="MR" />

    <Button
        android:id="@+id/ms"
        android:layout_row="2"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark"
        android:text="MS" />

    <Button
        android:id="@+id/c"
        android:layout_row="2"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark"
        android:text="C" />

    <Button
        android:id="@+id/ce"
        android:layout_row="2"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_dark"
        android:text="CE" />

    <!-- ROW 3 -->
    <Button
        android:id="@+id/seven"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="7" />

    <Button
        android:id="@+id/eight"
        android:layout_row="3"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="8" />

    <Button
        android:id="@+id/nine"
        android:layout_row="3"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="9" />

    <Button
        android:id="@+id/division"
        android:layout_row="3"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light"
        android:text="/" />

    <!-- ROW 4 -->
    <Button
        android:id="@+id/four"
        android:layout_row="4"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="4" />

    <Button
        android:id="@+id/five"
        android:layout_row="4"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="5" />

    <Button
        android:id="@+id/six"
        android:layout_row="4"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="6" />

    <Button
        android:id="@+id/multiply"
        android:layout_row="4"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light"
        android:text="*" />

    <!-- ROW 5 -->
    <Button
        android:id="@+id/one"
        android:layout_row="5"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="1" />

    <Button
        android:id="@+id/two"
        android:layout_row="5"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="2" />

    <Button
        android:id="@+id/three"
        android:layout_row="5"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="3" />

    <Button
        android:id="@+id/minus"
        android:layout_row="5"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light"
        android:text="-" />

    <!-- ROW 6 -->
    <Button
        android:id="@+id/pm"
        android:layout_row="6"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light"
        android:text="+/-" />

    <Button
        android:id="@+id/zero"
        android:layout_row="6"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/numbers"
        android:text="0" />

    <Button
        android:id="@+id/equal"
        android:layout_row="6"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/equals"
        android:text="=" />

    <Button
        android:id="@+id/plus"
        android:layout_row="6"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/operations_light"
        android:text="+" />

    <!-- ROW 7 (ADVANCED - HIDDEN) -->
    <Button
        android:id="@+id/sin"
        android:layout_row="7"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:text="sin"
        android:backgroundTint="@color/operations_light"
        android:visibility="gone" />

    <Button
        android:id="@+id/cos"
        android:layout_row="7"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:text="cos"
        android:backgroundTint="@color/operations_light"
        android:visibility="gone" />

    <Button
        android:id="@+id/tan"
        android:layout_row="7"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:text="tan"
        android:backgroundTint="@color/operations_light"
        android:visibility="gone" />

    <Button
        android:id="@+id/sqrt"
        android:layout_row="7"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:textColor="@android:color/white"
        android:text="√"
        android:backgroundTint="@color/operations_light"
        android:visibility="gone" />

</GridLayout>
