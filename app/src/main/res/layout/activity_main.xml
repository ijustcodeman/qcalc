<?xml version="1.0" encoding="utf-8"?>
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:rowCount="8"
    android:columnCount="4"
    android:padding="12dp"
    android:background="@color/bg_black">

    <TextView
        android:id="@+id/display"
        android:layout_row="0"
        android:layout_column="0"
        android:layout_columnSpan="4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="2"
        android:layout_columnWeight="1"
        android:text="0"
        android:textSize="64sp"
        android:textColor="@color/display_text"
        android:singleLine="true"
        android:ellipsize="start"
        android:gravity="bottom|end"
        android:padding="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sin"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="1"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="0.8"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="sin"
        android:textSize="16sp"
        android:backgroundTint="@color/btn_advanced_bg"
        android:textColor="@color/btn_number_text"
        android:visibility="gone"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cos"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="1"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="0.8"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="cos"
        android:textSize="16sp"
        android:backgroundTint="@color/btn_advanced_bg"
        android:textColor="@color/btn_number_text"
        android:visibility="gone"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/tan"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="1"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="0.8"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="tan"
        android:textSize="16sp"
        android:backgroundTint="@color/btn_advanced_bg"
        android:textColor="@color/btn_number_text"
        android:visibility="gone"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sqrt"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="1"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="0.8"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="√"
        android:textSize="16sp"
        android:backgroundTint="@color/btn_advanced_bg"
        android:textColor="@color/btn_number_text"
        android:visibility="gone"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/advanced"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="2"
        android:layout_column="0"
        android:layout_columnSpan="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="ADVANCED"
        android:textSize="14sp"
        android:backgroundTint="@color/btn_special_bg"
        android:textColor="@color/btn_special_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/leftBracket"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="2"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="("
        android:textSize="20sp"
        android:backgroundTint="@color/btn_special_bg"
        android:textColor="@color/btn_special_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/rightBracket"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="2"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text=")"
        android:textSize="20sp"
        android:backgroundTint="@color/btn_special_bg"
        android:textColor="@color/btn_special_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mr"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="3"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="MR"
        android:textSize="18sp"
        android:backgroundTint="@color/btn_special_bg"
        android:textColor="@color/btn_special_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ms"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="3"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="MS"
        android:textSize="18sp"
        android:backgroundTint="@color/btn_special_bg"
        android:textColor="@color/btn_special_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/c"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="3"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="AC"
        android:textSize="18sp"
        android:backgroundTint="@color/btn_special_bg"
        android:textColor="@color/btn_special_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ce"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_row="3"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="C"
        android:textSize="18sp"
        android:backgroundTint="@color/btn_special_bg"
        android:textColor="@color/btn_special_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/seven"
        android:layout_row="4"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="7"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/eight"
        android:layout_row="4"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="8"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nine"
        android:layout_row="4"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="9"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/division"
        android:layout_row="4"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="÷"
        android:textSize="28sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/four"
        android:layout_row="5"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="4"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/five"
        android:layout_row="5"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="5"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/six"
        android:layout_row="5"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="6"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/multiply"
        android:layout_row="5"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="×"
        android:textSize="28sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/one"
        android:layout_row="6"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="1"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/two"
        android:layout_row="6"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="2"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/three"
        android:layout_row="6"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="3"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/minus"
        android:layout_row="6"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="−"
        android:textSize="28sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pm"
        android:layout_row="7"
        android:layout_column="0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="±"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/zero"
        android:layout_row="7"
        android:layout_column="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="0"
        android:textSize="24sp"
        android:backgroundTint="@color/btn_number_bg"
        android:textColor="@color/btn_number_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/equal"
        android:layout_row="7"
        android:layout_column="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="="
        android:textSize="28sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:cornerRadius="50dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/plus"
        android:layout_row="7"
        android:layout_column="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_rowWeight="1"
        android:layout_columnWeight="1"
        android:layout_margin="4dp"
        android:text="+"
        android:textSize="28sp"
        android:backgroundTint="@color/btn_operator_bg"
        android:textColor="@color/btn_operator_text"
        app:cornerRadius="50dp" />

</GridLayout>
